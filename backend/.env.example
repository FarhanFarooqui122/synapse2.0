# Copy this file to .env and fill in ONE provider (Gemini free tier is default).
# Do NOT commit your real .env — only this example file is shared.

# Which LLM to use: gemini (free tier, default) or anthropic (paid fallback)
LLM_PROVIDER=gemini

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Optional model override (must be available on your key/tier)
GEMINI_MODEL=gemini-3.5-flash

# --- Anthropic (only needed if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Frontend origin(s) allowed by CORS (comma-separated) ---
FRONTEND_ORIGIN=http://localhost:5173
